# Model YOLO đã train. Đường dẫn tương đối được tính từ thư mục project.
MODEL_PATH=models/best.pt

# 0 = webcam laptop. Có thể thay bằng 1 hoặc URL RTSP của camera IP.
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# YOLO hiển thị box từ 0.25, nhưng chỉ crop/gọi OCR khi đạt ít nhất 0.80.
DETECTION_PREVIEW_THRESHOLD=0.25
DETECTION_THRESHOLD=0.80
SCAN_TIMEOUT_SECONDS=15
CROP_PADDING_RATIO=0.08

# Nhãn biển vuông trong model. Nhiều nhãn thì phân cách bằng dấu phẩy.
SQUARE_PLATE_LABELS=BSV

# Ví dụ Windows: C:/google-credentials/vision-service-account.json
# Không đặt file JSON bí mật trong Git và không gửi file này cho người khác.
GOOGLE_APPLICATION_CREDENTIALS=C:/duong-dan/toi/service-account.json

# Các tham số mới cho việc xác định biển số ổn định qua nhiều frame.
# Số frame liên tiếp mà một biển số phải xuất hiện để được coi là ổn định.
STABLE_FRAME_COUNT=5
CANDIDATE_WINDOW_SECONDS=1.5
MIN_SHARPNESS_SCORE=100
MAX_CENTER_SHIFT_RATIO=0.03

# Cấu hình MongoDB. Nếu không dùng database, có thể bỏ qua.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=license_plate_system

STATION_ID=GATE_01
CAMERA_ID=CAM_IN_01
CAMERA_DIRECTION=IN

DUPLICATE_WINDOW_SECONDS=10